<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <ImageView
        android:src="@mipmap/ic_launcher_round"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="10dp"/>
    <TextView
        android:text="User Name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="User ID: 123456789"
        android:layout_marginBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:text="$450.00\nWallet Balance"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <Button
            android:text="$1,280.40\nTotal Spent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <Button android:text="User Info" android:backgroundTint="#FFF" android:textColor="#000" android:textAlignment="viewStart" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:text="Saved Address" android:backgroundTint="#FFF" android:textColor="#000" android:textAlignment="viewStart" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:text="Warranty Policy" android:backgroundTint="#FFF" android:textColor="#000" android:textAlignment="viewStart" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnLogout"
        android:text="Logout"
        android:backgroundTint="#FFEBEE"
        android:textColor="#F44336"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>