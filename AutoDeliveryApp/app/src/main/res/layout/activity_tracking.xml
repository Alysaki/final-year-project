<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:text="Mission (ID Mission)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:text="On Mission"
        android:textColor="#4CAF50"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:text="[BẢN ĐỒ VỊ TRÍ ROBOT THỰC TẾ]"
        android:backgroundTint="#E0E0E0"
        android:textColor="#000"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:text="Estimated Time: 11:00 AM"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Button android:text="✔ Received (location)" android:backgroundTint="#FFF" android:textColor="#000" android:textAlignment="viewStart" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:text="✔ Processing (Ready)" android:backgroundTint="#FFF" android:textColor="#000" android:textAlignment="viewStart" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:text="⏳ Delivering (In transit)" android:backgroundTint="#4CAF50" android:textColor="#FFF" android:textAlignment="viewStart" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:text="○ Arrived" android:backgroundTint="#EEE" android:textColor="#AAA" android:textAlignment="viewStart" android:layout_width="match_parent" android:layout_height="wrap_content"/>

</LinearLayout>